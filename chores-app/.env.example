# Copy this file to .env (same folder) and fill it in. .env is gitignored: never commit it.

# Signs login cookies and the widget/backup links. Generate one with:
#   python -c "import secrets; print(secrets.token_hex())"
# Changing it logs everyone out and invalidates widget scripts and backup links.
SECRET_KEY=

# Your timezone (IANA name). Decides what "today" means; servers usually run on UTC.
APP_TZ=Europe/Berlin

# Optional: where the database lives. Default: chores.db next to the code.
# CHORES_DB=/home/yourname/chores.db
